# Safe local-development template for AI-Sentinel.
# Copy to .env locally; never commit the copied file or real credentials.

# Runtime settings
AI_SENTINEL_ENV=development
LOG_LEVEL=INFO

# LLM adapter placeholder. No provider or model is selected by this baseline.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# DefectDojo adapter placeholder. The endpoint and token are intentionally empty.
DEFECTDOJO_URL=
DEFECTDOJO_API_TOKEN=

# Future service authentication placeholders.
INTERNAL_API_BASE_URL=
INTERNAL_API_TOKEN=
