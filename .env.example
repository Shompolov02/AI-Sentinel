# Safe local-development template for AI-Sentinel.
# Copy to .env locally; never commit the copied file or real credentials.

# Runtime settings
AI_SENTINEL_ENV=development
LOG_LEVEL=INFO

# Phase 1 local Honeynet Compose settings
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
SERVER_NAME=localhost
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
PROD_NET_SUBNET=172.30.10.0/24
HONEYNET_SUBNET=172.30.20.0/24
COWRIE_INGRESS_SUBNET=172.30.30.0/24
HTTP_EDGE_SUBNET=172.30.40.0/24
HTTP_INGRESS_SUBNET=172.30.50.0/24

# LLM adapter placeholder. No provider or model is selected by this baseline.
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# DefectDojo adapter placeholder. The endpoint and token are intentionally empty.
DEFECTDOJO_URL=
DEFECTDOJO_API_TOKEN=

# Future service authentication placeholders.
INTERNAL_API_BASE_URL=
INTERNAL_API_TOKEN=
